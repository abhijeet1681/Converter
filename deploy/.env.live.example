# ConvertHub — LIVE server settings (copy to .env on the server, fill in the secrets, never commit it)
# Matches the Navicat connection "live_converter" (deploy/navicat/live_converter.ncx).

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Public address of the site, e.g. https://convert.example.in (used for canonical links + sitemap)
SITE_URL=
TRUST_PROXY=true
MAX_UPLOAD_MB=100
ENABLE_OFFICE_CONVERSION=true
SOFFICE_PATH=
OFFICE_TIMEOUT_SECONDS=180
MAX_CONCURRENT_JOBS=2
RATE_LIMIT_PER_HOUR=60

# ---------- MySQL: the live database "live_converter" (Navicat connection: Live_Db / live_converter) ----------
# Create it once with:  npm run db:init   (or run deploy/live_converter.sql in Navicat)
DB_ENABLED=true
DB_HOST=192.168.90.223
DB_PORT=3306
DB_USER=sfc_app
DB_PASSWORD=
DB_NAME=live_converter
# Hosted MySQL (Aiven / TiDB Cloud / RDS) needs TLS → DB_SSL=true, or use one line instead of the DB_* above:
# DATABASE_URL=mysql://user:password@host:3306/live_converter?ssl=true
DB_SSL=false
# Change to any long random string — visitor IPs are stored only as SHA-256(IP + salt)
IP_HASH_SALT=change-me-random-string

# ---------- Admin dashboard at /admin ----------
ADMIN_KEY=

# ---------- AI (optional on the server: install Ollama + a Whisper server, else leave the URLs empty) ----------
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b
WHISPER_URL=
AI_TIMEOUT_SECONDS=180
AI_MAX_INPUT_CHARS=60000
AI_RATE_LIMIT_PER_HOUR=40

# ---------- File archive → Google Drive ----------
# Every input + output file of every conversion is kept and uploaded to the Drive folder below.
ARCHIVE_FILES=true
# Linux server: /var/converthub-archive   Windows server: D:\converthub-archive   (Vercel: ignored, uses /tmp)
ARCHIVE_DIR=/var/converthub-archive
ARCHIVE_KEEP_DAYS=0
ARCHIVE_MAX_FILE_MB=50
GDRIVE_ENABLED=true
# The Drive folder everything goes into (the id from the folder's URL)
GDRIVE_FOLDER_ID=1M__NV3qx9nIHBpcQKLZwZSZKyPA1TT71
# Sub-folder created inside it: <folder>/ConvertHub/2026-10-02/<conversion-id>/input-….jpg
GDRIVE_FOLDER=ConvertHub
# Upload method A (recommended, works everywhere incl. Vercel): Google Drive API with YOUR Google login.
# Get the three values with:  npm run gdrive:auth   (one-time, opens the browser)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# Upload method B (only when the three values above are empty): rclone remote named below, logged in on this machine.
GDRIVE_REMOTE=gdrive
RCLONE_PATH=
