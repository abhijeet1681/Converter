# Copy this file to ".env" and change values as needed.

# Port the website runs on
PORT=3000
# 0.0.0.0 = reachable from your network, 127.0.0.1 = only this computer
HOST=0.0.0.0
# Public URL of your site (used for SEO canonical links + sitemap). Leave empty on localhost.
SITE_URL=
# Max upload size (MB) for server-side Office conversions
MAX_UPLOAD_MB=100
# Enable Word/PowerPoint/Excel -> PDF conversions via LibreOffice (true/false)
ENABLE_OFFICE_CONVERSION=true
# Full path to LibreOffice "soffice" if it is not auto-detected
# Windows example: C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=
# Seconds before a server conversion is killed
OFFICE_TIMEOUT_SECONDS=180
# How many LibreOffice conversions may run at the same time
MAX_CONCURRENT_JOBS=2
# Server conversions allowed per IP per hour
RATE_LIMIT_PER_HOUR=60
# Set to true when running behind Nginx / Cloudflare / a load balancer
TRUST_PROXY=false

# ---------- MySQL (optional — records usage analytics + file METADATA, never file contents) ----------
# Live server: DB_NAME=live_converter (create it with "npm run db:init" or deploy/live_converter.sql in Navicat)
DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=converthub
# Hosted MySQL (Aiven / TiDB Cloud / RDS…) requires TLS → DB_SSL=true. Or give everything in one line:
# DATABASE_URL=mysql://user:password@host:3306/live_converter?ssl=true   (overrides the DB_* values above)
DB_SSL=false
IP_HASH_SALT=change-me-random-string

# ---------- Admin dashboard at /admin (leave empty to disable) ----------
ADMIN_KEY=

# ---------- Local AI (Ollama for text, Whisper for speech; both optional) ----------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
WHISPER_URL=http://127.0.0.1:9000
AI_TIMEOUT_SECONDS=180
AI_MAX_INPUT_CHARS=60000
AI_RATE_LIMIT_PER_HOUR=40

# ---------- File archive (opt-in, default off): keep a copy of every converted file ----------
ARCHIVE_FILES=false
ARCHIVE_DIR=archive
ARCHIVE_KEEP_DAYS=30
ARCHIVE_MAX_FILE_MB=50
# Upload every archived file to your Google Drive
GDRIVE_ENABLED=false
# The Drive folder (id from its URL) and the sub-folder created inside it: <folder>/ConvertHub/2026-10-02/<conversion-id>/
GDRIVE_FOLDER_ID=
GDRIVE_FOLDER=ConvertHub
# Method A (recommended; the only one that works on Vercel): Google Drive API with your own Google login.
# One-time:  npm run gdrive:auth   → fills in the three values below (see README → Google Drive archive)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# Method B (used only while the three values above are empty): rclone remote logged in on this machine
# (install: winget install Rclone.Rclone, then one-time login — see README)
GDRIVE_REMOTE=gdrive
RCLONE_PATH=
